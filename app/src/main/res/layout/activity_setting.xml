<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".setting">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Settings"
        android:layout_marginTop="30dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GENERAL"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:textColor="#757575"/>

    <!-- Home Row -->
    <LinearLayout
        android:id="@+id/homepage"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="18sp"
            android:drawableStart="@drawable/home_svgrepo_com"
            android:drawablePadding="15dp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/baseline_arrow_forward_ios_24"
            app:tint="#757575"/>
    </LinearLayout>

    <!-- Edit Profile Row -->
    <LinearLayout
        android:id="@+id/editpage"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Profile"
            android:textSize="18sp"
            android:drawableStart="@drawable/edit_3_svgrepo_com"
            android:drawablePadding="15dp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/baseline_arrow_forward_ios_24"
            app:tint="#757575"/>
    </LinearLayout>

    <!-- Set Location Row -->
    <LinearLayout
        android:id="@+id/locationpage"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Set Location"
            android:textSize="18sp"
            android:drawableStart="@drawable/location_pin_svgrepo_com"
            android:drawablePadding="15dp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/baseline_arrow_forward_ios_24"
            app:tint="#757575"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APPEARANCE"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:textColor="#757575"/>

    <LinearLayout
        android:id="@+id/darkmode_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dark Mode"
            android:textSize="18sp"
            android:drawableStart="@drawable/dark_mode_night_moon_svgrepo_com"
            android:drawablePadding="15dp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"/>

        <ImageView
            android:id="@+id/darkmode_switch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/switch_on_svgrepo_com"/>
    </LinearLayout>

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="#0288D1"
        android:layout_marginTop="40dp"
        android:text="Logout"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="12dp"
        android:layout_gravity="center"/>
</LinearLayout>
